# ── Models (Ollama) ──────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────────────────────
# Postgres, and an *async* driver — every query in the app is awaited, so a
# plain `postgresql://` URL is refused at startup rather than failing on the
# first request. asyncpg ships in the lockfile.
#   postgresql+asyncpg://user:password@localhost:5432/filing_analyzer
#
# `docker compose up` sets this for you from POSTGRES_* in the root .env; this
# value is for running the API on the host against a Postgres of your own.
DATABASE_URL=postgresql+asyncpg://analyzer:analyzer@localhost:5432/filing_analyzer

# Log every statement the ORM emits. Noisy — for debugging only.
DB_ECHO=false

# Connection pool, per API process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Connections older than this are replaced rather than reused, so a pool does
# not accumulate ones a proxy or the server has quietly closed.
DB_POOL_RECYCLE_SECONDS=1800

# ── Conversation history ─────────────────────────────────────────────────
# Messages are rows in the database above; these bound the much smaller
# history a single run is actually sent. What the analyst sees is never
# trimmed — only what reaches the model is.

# Recent turns carried into a run, and the ceiling on what they may cost.
# Whichever runs out first is what trims the history.
HISTORY_CONTEXT_MESSAGES=10
HISTORY_CONTEXT_TOKENS=1500

# Unsummarised turns tolerated before the older ones are folded into the
# conversation's rolling summary. Raise it to summarise less often and send
# more verbatim history; lower it for longer conversations on a small model.
HISTORY_SUMMARY_THRESHOLD=24

# Page size when the browser reads a dossier's ledger back.
HISTORY_PAGE_SIZE=50
HISTORY_MAX_PAGE_SIZE=200

# ── Redis (optional) ─────────────────────────────────────────────────────
# A read cache in front of the message table, holding each conversation's
# recent tail. Leave REDIS_URL blank and the cache is simply off — every read
# goes to the database, which is correct, just slower. Nothing is stored only
# in Redis, so flushing it loses nothing.
#   redis://localhost:6379/0
#   rediss://:password@redis.example.com:6380/0   (TLS)
REDIS_URL=

# Namespace for the keys, so one Redis can serve several apps.
REDIS_KEY_PREFIX=cfa

# Messages kept hot per conversation. Raised to HISTORY_CONTEXT_MESSAGES if
# set below it — a cache shorter than the window a run reads would miss every
# time.
REDIS_HOT_WINDOW=40

# How long an untouched conversation stays cached. Every read pushes it out
# again, so active dossiers stay hot and abandoned ones fall out on their own.
REDIS_TTL_SECONDS=3600

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs both token kinds. REQUIRED in any real deployment — without it the
# app signs with a random key that changes on every restart, logging everyone
# out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256

# Access tokens are sent on every request, so they are kept short — revoking a
# session takes effect within this window.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a client can stay signed in without re-entering a password. Each
# use rotates the token, so this is a sliding window, not a hard deadline.
REFRESH_TOKEN_EXPIRE_DAYS=14

# Origins allowed to call the API. Comma-separated or a JSON list; ["*"] is
# fine for local work, but name your real origins in production.
# CORS_ORIGINS=http://localhost:5500,https://analyzer.example.com
