# Settings for `docker compose up`. Copy to `.env` beside docker-compose.yml —
# compose reads that file automatically:
#
#     cp .env.example .env
#
# Every value here has a working default in docker-compose.yml, so the stack
# starts without this file. Set JWT_SECRET_KEY before anything real.

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs both access and refresh tokens. Leave it empty and the API signs with
# a random key that dies with the process, logging everyone out on restart.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ── Where the workbench is published ─────────────────────────────────────
FRONTEND_PORT=8080

# Origins the API accepts. Comma-separated or a JSON list; must include the
# origin the browser actually loads, i.e. the FRONTEND_PORT above.
CORS_ORIGINS=http://localhost:8080

# ── Database ─────────────────────────────────────────────────────────────
# Used both to initialise Postgres and to build the API's DATABASE_URL.
# Changing these after the first run needs the volume dropped as well:
#   docker compose down -v
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=analyzer
POSTGRES_DB=filing_analyzer

# ── Models (Ollama, running on the host) ─────────────────────────────────
# The stack does not contain Ollama. Pull the two models first:
#   ollama pull llama3.1:latest
#   ollama pull nomic-embed-text:latest
#
# Ollama must also be listening on more than loopback for the container to
# reach it:  OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
